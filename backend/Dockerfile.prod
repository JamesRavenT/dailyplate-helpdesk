FROM oven/bun:1

WORKDIR /app

COPY backend/package.json backend/bun.lock ./
RUN bun install --frozen-lockfile

COPY backend/ ./
COPY backend/docker-entrypoint.sh ./docker-entrypoint.sh

RUN chmod +x ./docker-entrypoint.sh

RUN DATABASE_URL_UNPOOLED="postgresql://placeholder:placeholder@localhost:5432/placeholder" DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder" bun node_modules/prisma/build/index.js generate

ENV NODE_ENV=production

EXPOSE 3001

CMD ["./docker-entrypoint.sh"]
