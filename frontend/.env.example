# Cloudflare Worker routing is configured separately: set BACKEND_ORIGIN per environment
# in frontend/wrangler.jsonc or the Cloudflare dashboard, not in this .env file.

# Sentry — optional frontend build-time configuration
VITE_SENTRY_DSN=

# Optional; required only for Sentry source-map uploads during builds
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Public project identifier (not a secret). Vite inlines this at build time, so set it in every
# environment that runs `vite build`, including the Cloudflare deploy environment, not just locally.
VITE_ACCESS_PROJECT_ID=
