# Server
PORT=3001
NODE_ENV=development

# Database
# Neon: use the pooled -pooler host for runtime and the direct host for Prisma CLI/migrations.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@ep-example-pooler.region.aws.neon.tech/helpdesk?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@ep-example.region.aws.neon.tech/helpdesk?sslmode=require

# Better Auth
# In production, both URLs are the public Cloudflare application URL.
BETTER_AUTH_SECRET=change-me-to-a-minimum-32-char-random-string
BETTER_AUTH_URL=https://helpdesk.example.com
FRONTEND_URL=https://helpdesk.example.com

# Seed — initial admin account (created on first boot, idempotent)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# AI provider defaults to OpenAI when unset. The stub is test-only and rejected in production.
AI_PROVIDER=openai
# OpenAI — inbound triage plus ticket summarization and reply polishing
OPENAI_API_KEY=sk-...

# Internal API — high-entropy random token shared with the n8n inbound-gateway
# workflow that calls /api/internal/resend-inbound.
INTERNAL_API_TOKEN=change-me-to-a-high-entropy-random-string

# Resend — outbound email plus fetching full inbound email content
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=support@example.com
# This now lives in the n8n workflow for Svix verification; the backend no longer verifies it.
RESEND_INBOUND_SECRET=whsec_...

# Legacy local-testing webhook only, disabled in production
WEBHOOK_SECRET=change-me-to-a-random-string

# Sentry — optional; leave blank to disable backend error reporting
SENTRY_DSN=
# VITE_SENTRY_DSN is a frontend build-time variable; configure it in frontend/.env.
